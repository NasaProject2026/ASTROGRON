{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astragron.org/schemas/adaptive_evidence_request_v1.schema.json",
  "title": "ASTRAGRON Adaptive Evidence Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "location"],
  "properties": {
    "schema": {
      "const": "astragron.adaptive-evidence.request.v1"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "as_of": {
      "type": "string",
      "description": "ISO-8601 UTC timestamp for historical snapshot cutoff validation."
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["point_lon_lat"],
      "properties": {
        "site_id": { "type": ["string", "null"] },
        "name": { "type": ["string", "null"] },
        "point_lon_lat": {
          "type": "array",
          "items": { "type": "number" }
        },
        "crs": {
          "type": "string",
          "default": "EPSG:4326"
        },
        "geometry": {
          "type": ["object", "null"]
        }
      }
    },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start": { "type": "string" },
        "end": { "type": "string" }
      }
    },
    "soil_depth_intervals_cm": {
      "type": "array",
      "items": {
        "type": "array",
        "items": { "type": "number" },
        "minItems": 2,
        "maxItems": 2
      }
    },
    "candidate_crops": {
      "type": "array",
      "items": { "type": "string" }
    },
    "water_supply_scenario": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "regime": { "type": "string", "enum": ["rainfed", "irrigated", "supplemental"] },
        "seasonal_supply_m3_ha": { "type": ["number", "null"] },
        "official_water_permit_verified": { "type": "boolean" }
      }
    },
    "user_measurements": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "theta_fc": { "type": ["number", "null"] },
        "theta_wp": { "type": ["number", "null"] },
        "awc_mm_m": { "type": ["number", "null"] },
        "root_depth_m": { "type": ["number", "null"] },
        "mineral_n_kg_ha": { "type": ["number", "null"] },
        "input_cost_eur_ha": { "type": ["number", "null"] },
        "official_pesticide_clearance_verified": { "type": "boolean" }
      }
    },
    "options": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "acquisition": { "type": "string", "enum": ["CACHE_ONLY", "FETCH_ALLOWED"] },
        "allow_offline_reference_fixture": { "type": "boolean" },
        "allow_conditional_crop_planning": { "type": "boolean" },
        "allow_gaez_contract_fixture": { "type": "boolean" },
        "simulate_nasa_outage": { "type": "boolean" },
        "simulate_soilgrids_outage": { "type": "boolean" },
        "simulate_corrupt_receipt": { "type": "boolean" }
      }
    }
  }
}
