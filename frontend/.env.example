# ASTRAGRON Frontend Runtime Environment Configuration
# Commercial licensed geocoder proxy (/api/geocode) - Recommended for commercial SLA production:
# Supported commercial/custom providers: auto | generic | geoapify | maptiler | photon | open_meteo
# When configuring a custom/commercial endpoint, BOTH HTTPS endpoint AND explicit allowed hosts are required.
# Public OpenStreetMap Nominatim (nominatim.openstreetmap.org) is strictly blocked by security policy.

# ASTRAGRON_GEOCODER_PROVIDER=geoapify
# ASTRAGRON_GEOCODER_ENDPOINT=https://api.geoapify.com/v1/geocode/search
# ASTRAGRON_GEOCODER_ALLOWED_HOSTS=api.geoapify.com
# ASTRAGRON_GEOCODER_API_KEY=

# By default when no commercial key is set, /api/geocode uses allowlisted keyless providers:
# - Open-Meteo Geocoding API (CC BY 4.0, non-commercial research/educational settlements)
# - Photon Community OSM Demo (ODbL, best-effort rate-limited server, no uptime SLA, streets/postcodes)
# Set to 1 to force fail-closed 503 GEOCODER_NOT_CONFIGURED when commercial keys are absent:
# ASTRAGRON_GEOCODER_DISABLE_KEYLESS=0

# Intelligent Field Boundary Suggestions (FTW / GeoParquet)
# Default live source queries Fields of The World 2nd Edition (global-data-2e, CC-BY-4.0)
# over HTTP Range GeoParquet from data.source.coop. Optionally point to an enterprise FTW API:
# ASTRAGRON_FTW_SUGGEST_ENDPOINT=
# ASTRAGRON_FTW_ALLOWED_HOSTS=
# ASTRAGRON_FTW_API_KEY=
# ASTRAGRON_FTW_DATASET_NAME=Fields of The World (FTW) 2nd Edition
# ASTRAGRON_FTW_DATASET_YEAR=2025
# ASTRAGRON_FTW_DISABLE_LIVE_PARQUET=0

# Optional remote scientific analysis, verified capability polygons, and chat endpoints
# ASTRAGRON_BACKEND_URL=
# ASTRAGRON_CAPABILITY_FOOTPRINTS_ENDPOINT=
# ASTRAGRON_CAPABILITY_ALLOWED_HOSTS=
# ASTRAGRON_CHAT_ENDPOINT=
